 "signs": [
  {
   "map": "village",
   "x": 5,
   "y": 11,
   "text": "บ้านเรา"
  },
  {
   "map": "village",
   "x": 17,
   "y": 9,
   "text": "ศาลากลางบ้าน — ผู้ใหญ่บ้านสมบัติ"
  },
  {
   "map": "village",
   "x": 17,
   "y": 11,
   "text": "ร้านชำป้าสมร — ข้าวเหนียว ยา ขนม"
  },
  {
   "map": "village",
   "x": 29,
   "y": 11,
   "text": "ศาลา อสม. ป้านวล — รักษาฟรี"
  },
  {
   "map": "village",
   "x": 12,
   "y": 4,
   "text": "วัดบ้านโนนสะอาด"
  },
  {
   "map": "village",
   "x": 24,
   "y": 4,
   "text": "โรงเรียนบ้านโนนสะอาด"
  },
  {
   "map": "village",
   "x": 17,
   "y": 26,
   "text": "ทางลงทุ่งนาหลังหมู่บ้าน"
  },
  {
   "map": "village",
   "x": 2,
   "y": 6,
   "text": "ดอนปู่ตา ห้ามเข้า"
  },
  {
   "map": "field",
   "x": 15,
   "y": 13,
   "text": "หนองใหญ่ ระวังคางคกเจ้าหนอง"
  },
  {
   "map": "market",
   "x": 17,
   "y": 6,
   "text": "ร้านราเมงลมทุ่ง — ฐานแก๊งพี่ออสซี่ (ยิม 1)"
  },
  {
   "map": "market",
   "x": 22,
   "y": 7,
   "text": "ป้ายรถสองแถว ตลาดนัดตำบล – มหาวิทยาลัยขอนแก่น"
  },
  {
   "map": "kku",
   "x": 1,
   "y": 12,
   "text": "ป้ายรถสองแถว มข. – ตลาดนัดตำบล"
  },
  {
   "map": "kku",
   "x": 9,
   "y": 9,
   "text": "คณะวิศวกรรมศาสตร์ — ตึกเรียนรวม ห้องแล็บเคมีอยู่ชั้นนี้"
  },
  {
   "map": "kku",
   "x": 21,
   "y": 2,
   "text": "ลานจอดรถจักรยานยนต์ ห้ามจอดขวางทางเดิน"
  },
  {
   "map": "kku",
   "x": 32,
   "y": 9,
   "text": "โรงช็อปวิศวะ — เขตพี่ว้าก ผ่านไม่ได้ถ้ายังไม่ชนะพี่ว้ากทั้งสองคน!"
  },
  {
   "map": "kku",
   "x": 14,
   "y": 22,
   "text": "โรงอาหารวิศวะ — น้ำปั่นอิงอิงอร่อยที่สุดในคณะ!"
  },
  {
   "map": "kku",
   "x": 16,
   "y": 18,
   "text": "หมูกระทะลุงเฉลิม — รับคูปองเลี้ยงน้องวิศวะ"
  },
  {
   "map": "kku",
   "x": 33,
   "y": 24,
   "text": "บึงสีฐาน — ห้ามให้อาหารปลาเกินวันละสามถุง"
  },
  {
   "map": "kku",
   "x": 42,
   "y": 13,
   "text": "สะพานข้ามลำน้ำพอง ปิดซ่อม (เปิดให้ผู้ที่มีตราเฟือง) → ทางไปโรงพยาบาลอำเภอ"
  },
  {
   "map": "kku",
   "x": 42,
   "y": 18,
   "text": "ระวัง! น้องวิศวะชอบเดินหลงในหญ้ารก ชวนเข้าแก๊งได้ด้วยคูปองหมูกระทะ"
  }
 ],
